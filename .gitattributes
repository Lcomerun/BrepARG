# Preserve copied experiment logs and TensorBoard events byte-for-byte.
# Keep the P0-A evidence manifest reproducible across Windows and Linux: Git
# stores these report files with LF bytes, matching the snapshot writer.
reports/p0a_assembly_chain_evidence_20260817/*.json text eol=lf
reports/p0a_assembly_chain_evidence_20260817/*.jsonl text eol=lf
reports/p0a_assembly_chain_evidence_20260817/*.csv text eol=lf
reports/p0a_assembly_chain_evidence_20260817/*.md text eol=lf
reports/training_results/**/*.log -text
reports/training_results/**/events.out.tfevents.* -text
reports/tensorboard/**/events.out.tfevents.* -text
reports/**/logs/*.log -text
reports/**/tensorboard/**/events.out.tfevents.* -text

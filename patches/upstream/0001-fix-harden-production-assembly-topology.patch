+def build_face_edge_adjacency(
+    face_ids: Sequence[int],
+    edge_face_pairs: Sequence[tuple[int, int]],
+    *,
+    num_edges: Optional[int] = None,
+) -> list[list[int]]:
+    """Map declared face IDs to decoded-face positions without truncation.
+
+    A malformed sequence is rejected rather than silently remapping or
+    dropping topology. A self-edge belongs to its face exactly once.
+    """
+    normalized_ids = [int(face_id) for face_id in face_ids]
+    if len(set(normalized_ids)) != len(normalized_ids):
+        raise ValueError("decoded sequence contains duplicate face ids")
+    if num_edges is not None and len(edge_face_pairs) != int(num_edges):
+        raise ValueError(
+            f"edge topology count ({len(edge_face_pairs)}) does not match decoded edge count ({num_edges})"
+        )
+
+    face_id_to_index = {face_id: index for index, face_id in enumerate(normalized_ids)}
+    adjacency = [[] for _ in normalized_ids]
+    for edge_index, pair in enumerate(edge_face_pairs):
+        if len(pair) != 2:
+            raise ValueError(f"edge {edge_index} must reference exactly two faces")
+        source_id, target_id = (int(pair[0]), int(pair[1]))
+        missing = [
+            face_id for face_id in (source_id, target_id)
+            if face_id not in face_id_to_index
+        ]
+        if missing:
+            raise ValueError(
+                f"edge {edge_index} references undeclared face ids {missing}"
+            )
+        adjacency[face_id_to_index[source_id]].append(edge_index)
+        if target_id != source_id:
+            adjacency[face_id_to_index[target_id]].append(edge_index)
+    return adjacency
+

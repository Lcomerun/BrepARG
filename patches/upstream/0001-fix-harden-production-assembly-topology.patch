+def resolve_edge_scale(scale_target, scale_ncs, edge_points, edge_bbox=None):
+    """Choose an edge scale without dividing by a closed-edge endpoint span."""
+    epsilon = 1e-9
+    if scale_target > epsilon and scale_ncs > epsilon:
+        return scale_target / scale_ncs
+
+    if edge_bbox is not None:
+        bbox = np.asarray(edge_bbox, dtype=np.float64)
+        if bbox.shape != (6,):
+            raise ValueError(f"edge bbox must have shape (6,), got {bbox.shape}")
+        curve_span = get_bbox_norm(np.asarray(edge_points).reshape(-1, 3))
+        bbox_span = np.linalg.norm(bbox[3:] - bbox[:3])
+        if curve_span > epsilon and bbox_span > epsilon:
+            return bbox_span / curve_span
+
+    if scale_target <= epsilon and scale_ncs <= epsilon:
+        # No physical extent remains to infer a scale. Preserve the decoded
+        # closed curve instead of producing inf or NaN.
+        return 1.0
+    raise ValueError("edge has a degenerate endpoint scale without usable bbox extent")
+
